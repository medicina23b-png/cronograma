rules_version = '2';
// Regras para o projeto cronograma-23b, deduzidas de como o app lê/grava cada coleção.
// Login: usuario@turma23b.local (o presidente é presidente@turma23b.local).
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function presidente() { return logado() && request.auth.token.email == 'presidente@turma23b.local'; }
    function dono(u) { return logado() && u is string && request.auth.token.email == u + '@turma23b.local'; }

    match /usuarios/{u} {
      allow read: if presidente() || dono(u);
      allow write: if presidente() || dono(u);
    }
    match /{col}/{id} {
      // conteúdo da turma: todo discente logado lê; só o presidente altera
      allow read: if logado() && col in ['eventos', 'arquivos', 'mural', 'datasImportantes', 'config'];
      allow write: if presidente() && col in ['eventos', 'arquivos', 'mural', 'datasImportantes', 'config', 'semestres'];
    }
    match /config/{id} { allow write: if presidente(); }       // aniversariantes é publicado pelo presidente
    match /semestres/{id} { allow read, write: if presidente(); }
    match /acompanhados/{id} {
      allow read: if presidente() || dono(resource.data.usuario);
      allow create, update: if presidente() || dono(request.resource.data.usuario);
      allow delete: if presidente() || dono(resource.data.usuario);
    }
    match /muralLido/{id} {
      allow read: if logado();
      allow create, update: if presidente() || dono(request.resource.data.usuario);
      allow delete: if presidente();
    }
    match /muralVotos/{id} {
      allow read: if logado();
      allow create, update: if presidente() || dono(request.resource.data.usuario);
      allow delete: if presidente() || dono(resource.data.usuario);
    }
    match /notas/{id} {
      allow read: if presidente() || dono(resource.data.usuario);
      allow create, update: if presidente() || dono(request.resource.data.usuario);
      allow delete: if presidente() || dono(resource.data.usuario);
    }
    match /avaliacoes/{id} {
      allow read: if presidente() || dono(resource.data.usuario);
      allow write: if presidente();
    }
    match /sessoesTutoria/{id} {
      allow read, write: if logado();     // qualquer discente conduz a sessão de tutoria
    }
    match /notificacoes/{u}/itens/{i} {
      allow read, update, delete: if presidente() || dono(u);
      allow create: if presidente() || dono(u);
    }
    match /pushTokens/{id} {
      allow create, update: if logado() && dono(request.resource.data.usuario);
      allow delete: if logado() && dono(resource.data.usuario);
      allow read: if false;
    }
  }
}
